# Anchoring provider (optional). When set, anchors are published to a real,
# immutable, public GitHub Gist. When unset, the app falls back to a clearly
# labelled local append-only ledger so the demo still works offline.
# For production, wire OpenTimestamps (Bitcoin) or a permissioned ledger.
GITHUB_TOKEN=

# Real transactional email via Resend (optional). When set, notifications are
# also sent for real. When unset, emails are written to the in-app /inbox.
RESEND_API_KEY=
RESEND_FROM=SevaPath <onboarding@resend.dev>

# Cross-instance store (optional). Set these to use Supabase Postgres for
# guaranteed shared state across Vercel serverless instances. When unset,
# the app falls back to the local JSON file store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
